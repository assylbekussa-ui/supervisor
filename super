<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tap Taza — Кабинет Супервайзера</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://www.gstatic.com/firebasejs/9.23.0/firebase-app-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/9.23.0/firebase-database-compat.js"></script>
    <script src="tt-core.js"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Plus Jakarta Sans', 'sans-serif'],
                    },
                    colors: {
                        brand: {
                            50: '#f0fdf4',
                            100: '#dcfce7',
                            500: '#22c55e',
                            600: '#16a34a',
                            700: '#15803d',
                        },
                        brandBlue: '#0052a5',
                    }
                }
            }
        }
    </script>
    <style>
        .glass-card {
            background: rgba(255, 255, 255, 0.9);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(226, 232, 240, 0.8);
        }
        .step-inactive { opacity: 0.5; pointer-events: none; filter: grayscale(1); }
    </style>
</head>
<body class="bg-slate-100 text-slate-800 font-sans antialiased min-h-screen pb-12">

    <!-- Header -->
    <header class="sticky top-0 z-50 bg-white border-b border-slate-200 shadow-sm">
        <div class="max-w-md mx-auto px-4 h-16 flex items-center justify-between">
            <div class="flex items-center gap-2">
                <svg class="h-8 w-auto" viewBox="0 0 160 140" fill="none">
                    <path d="M 35 15 C 35 10, 110 10, 110 10 C 110 10, 105 26, 82 26 L 62 26 L 46 110 C 44 118, 36 120, 28 120 L 18 120 L 36 26 L 15 26 C 10 26, 10 15, 35 15 Z" fill="#0052A5"/>
                    <path d="M 68 30 C 68 25, 142 25, 142 25 C 142 25, 137 41, 114 41 L 94 41 L 78 125 C 76 133, 68 135, 60 135 L 50 135 L 68 41 L 47 41 C 42 41, 42 30, 68 30 Z" fill="#16A34A"/>
                </svg>
                <div>
                    <span class="text-base font-black text-[#0052a5] block leading-none">Tap Taza</span>
                    <span class="text-[10px] font-bold text-slate-500 uppercase tracking-wider">Панель Супервайзера</span>
                </div>
            </div>
            <div id="status-badge" class="px-2.5 py-1 rounded-full bg-slate-200 text-slate-700 text-xs font-bold">
                Ожидание
            </div>
        </div>
    </header>

    <main class="max-w-md mx-auto px-4 pt-6 space-y-6">

        <!-- STEP 1: Object Details & Arrival -->
        <div id="step-1" class="glass-card rounded-2xl p-5 shadow-sm transition-all border-2 border-brand-600">
            <div class="flex items-center gap-2 mb-4">
                <span class="w-7 h-7 rounded-lg bg-brand-600 text-white font-black text-xs flex items-center justify-center">1</span>
                <h2 class="font-extrabold text-slate-900 text-base">Данные объекта и прибытие</h2>
            </div>

            <div class="space-y-4">
                <div>
                    <label class="block text-xs font-bold text-slate-600 mb-1">Заказ из CRM</label>
                    <select id="obj-order" onchange="pickOrder()" class="w-full px-3 py-2.5 rounded-xl border border-slate-300 text-sm focus:outline-none focus:border-brand-600 bg-white font-semibold">
                        <option value="">Загрузка заказов…</option>
                    </select>
                    <div id="order-info" class="hidden mt-2 text-xs bg-brand-50 border border-brand-100 rounded-xl p-3 leading-relaxed"></div>
                </div>
                <div>
                    <label class="block text-xs font-bold text-slate-600 mb-1">Супервайзер</label>
                    <input type="text" id="sup-name" placeholder="Ваше имя" class="w-full px-3 py-2.5 rounded-xl border border-slate-300 text-sm focus:outline-none focus:border-brand-600 bg-white">
                </div>
                <div>
                    <label class="block text-xs font-bold text-slate-600 mb-1">Адрес объекта *</label>
                    <input type="text" id="obj-address" placeholder="Напр: пр. Достык 105, кв 42" class="w-full px-3 py-2.5 rounded-xl border border-slate-300 text-sm focus:outline-none focus:border-brand-600 bg-white">
                </div>

                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block text-xs font-bold text-slate-600 mb-1">Тип объекта</label>
                        <select id="obj-type" class="w-full px-3 py-2.5 rounded-xl border border-slate-300 text-sm focus:outline-none focus:border-brand-600 bg-white font-medium">
                            <option value="Квартира">🏢 Квартира</option>
                            <option value="Офис">🏢 Офис</option>
                            <option value="Частный дом">🏡 Частный дом</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-slate-600 mb-1">Вид уборки</label>
                        <select id="cleaning-type" onchange="renderChecklist()" class="w-full px-3 py-2.5 rounded-xl border border-slate-300 text-sm focus:outline-none focus:border-brand-600 bg-white font-medium">
                            <option value="standard">Поддерживающая</option>
                            <option value="general">Генеральная</option>
                            <option value="repair">После ремонта</option>
                        </select>
                    </div>
                </div>

                <button type="button" onclick="arriveOnSite()" class="w-full bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-3.5 rounded-xl shadow-lg shadow-emerald-600/20 transition-all flex items-center justify-center gap-2 text-sm">
                    <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/></svg>
                    Прибыл на объект (в WhatsApp)
                </button>
            </div>
        </div>

        <!-- STEP 2: Photos BEFORE -->
        <div id="step-2" class="glass-card rounded-2xl p-5 shadow-sm step-inactive transition-all">
            <div class="flex items-center justify-between mb-3">
                <div class="flex items-center gap-2">
                    <span class="w-7 h-7 rounded-lg bg-brand-600 text-white font-black text-xs flex items-center justify-center">2</span>
                    <h2 class="font-extrabold text-slate-900 text-base">Фото ДО уборки</h2>
                </div>
                <span class="text-xs text-slate-400 font-medium" data-cnt>до 8 фото</span>
            </div>

            <p class="text-xs text-slate-500 mb-4">Сделайте фото общих планов и проблемных мест до начала работ.</p>

            <div class="space-y-3">
                <input type="file" id="files-before" multiple accept="image/*" class="hidden" onchange="handleFileSelect(this, 'before')">
                <label for="files-before" class="w-full border-2 border-dashed border-slate-300 hover:border-brand-600 rounded-xl py-4 flex flex-col items-center justify-center cursor-pointer bg-white transition-all">
                    <span class="text-2xl mb-1">📸</span>
                    <span class="text-xs font-bold text-slate-700">Выбрать или сделать снимки</span>
                </label>

                <div id="preview-before" class="grid grid-cols-3 gap-2 empty:hidden"></div>

                <button type="button" onclick="uploadFolder('before')" class="w-full bg-brandBlue hover:bg-blue-800 text-white font-bold py-3 rounded-xl shadow-md transition-all text-xs flex items-center justify-center gap-2">
                    ✅ Фото ДО готовы — дальше
                </button>
            </div>
        </div>

        <!-- STEP 3: Checklist (25 Points) -->
        <div id="step-3" class="glass-card rounded-2xl p-5 shadow-sm step-inactive transition-all">
            <div class="flex items-center justify-between mb-2">
                <div class="flex items-center gap-2">
                    <span class="w-7 h-7 rounded-lg bg-brand-600 text-white font-black text-xs flex items-center justify-center">3</span>
                    <h2 class="font-extrabold text-slate-900 text-base">Чек-лист качества</h2>
                </div>
                <span id="checklist-counter" class="text-xs font-extrabold text-brand-700 bg-brand-100 px-2 py-1 rounded-lg">0 / 25</span>
            </div>

            <!-- Progress Bar -->
            <div class="w-full bg-slate-200 h-2 rounded-full overflow-hidden mb-4">
                <div id="checklist-progress" class="bg-brand-600 h-full w-0 transition-all duration-300"></div>
            </div>

            <div id="checklist-container" class="space-y-2.5 max-h-80 overflow-y-auto pr-1 text-xs">
                <!-- Dynamic Items Inserted via JS -->
            </div>

            <button type="button" id="btn-finish-checklist" onclick="completeChecklist()" class="w-full mt-4 bg-brand-600 hover:bg-brand-700 text-white font-bold py-3 rounded-xl shadow-md transition-all text-xs">
                Подтвердить выполнение всех пунктов
            </button>
        </div>

        <!-- STEP 4: Photos AFTER -->
        <div id="step-4" class="glass-card rounded-2xl p-5 shadow-sm step-inactive transition-all">
            <div class="flex items-center justify-between mb-3">
                <div class="flex items-center gap-2">
                    <span class="w-7 h-7 rounded-lg bg-brand-600 text-white font-black text-xs flex items-center justify-center">4</span>
                    <h2 class="font-extrabold text-slate-900 text-base">Фото ПОСЛЕ уборки</h2>
                </div>
                <span class="text-xs text-slate-400 font-medium" data-cnt>до 8 фото</span>
            </div>

            <p class="text-xs text-slate-500 mb-4">Сделайте фото сияющих чистотой комнат, сантехники и узлов.</p>

            <div class="space-y-3">
                <input type="file" id="files-after" multiple accept="image/*" class="hidden" onchange="handleFileSelect(this, 'after')">
                <label for="files-after" class="w-full border-2 border-dashed border-slate-300 hover:border-brand-600 rounded-xl py-4 flex flex-col items-center justify-center cursor-pointer bg-white transition-all">
                    <span class="text-2xl mb-1">✨</span>
                    <span class="text-xs font-bold text-slate-700">Сделать финальные снимки</span>
                </label>

                <div id="preview-after" class="grid grid-cols-3 gap-2 empty:hidden"></div>

                <button type="button" onclick="uploadFolder('after')" class="w-full bg-brandBlue hover:bg-blue-800 text-white font-bold py-3 rounded-xl shadow-md transition-all text-xs flex items-center justify-center gap-2">
                    ✅ Фото ПОСЛЕ готовы — дальше
                </button>
            </div>
        </div>

        <!-- STEP 5 & 6: Client Acceptance & Exit -->
        <div id="step-5" class="glass-card rounded-2xl p-5 shadow-sm step-inactive transition-all space-y-3">
            <div class="flex items-center gap-2 mb-2">
                <span class="w-7 h-7 rounded-lg bg-brand-600 text-white font-black text-xs flex items-center justify-center">5</span>
                <h2 class="font-extrabold text-slate-900 text-base">Приемка и Завершение</h2>
            </div>

            <button type="button" id="btn-accept" onclick="acceptByClient()" class="w-full bg-amber-500 hover:bg-amber-600 text-white font-extrabold py-3.5 rounded-xl shadow-md transition-all text-xs flex items-center justify-center gap-2">
                🤝 Объект принят — сохранить отчёт
            </button>

            <textarea id="sup-remarks" rows="2" placeholder="Замечания / что сказал клиент" class="w-full px-3 py-2.5 rounded-xl border border-slate-300 text-sm focus:outline-none focus:border-brand-600 bg-white"></textarea>
            <div id="report-result" class="hidden text-xs bg-emerald-50 border border-emerald-200 rounded-xl p-3 space-y-2"></div>

            <button type="button" id="btn-exit" onclick="leaveObject()" disabled class="w-full bg-slate-900 hover:bg-slate-800 text-white font-extrabold py-3.5 rounded-xl shadow-md transition-all text-xs flex items-center justify-center gap-2 opacity-50 cursor-not-allowed">
                🚪 Покинули объект (Завершить смену)
            </button>
        </div>

    </main>

    <script>
        // ====== Мобильный кабинет супервайзера: заказы из CRM, отчёт в Firebase ======
        if (!firebase.apps.length) firebase.initializeApp(TT.FIREBASE);
        const db = firebase.database();
        const WHATSAPP_SUPPORT_GROUP = "https://chat.whatsapp.com/Cwt9SySl2f0L6v0QmvJbtf?s=sh&p=i&mlu=4";
        const photos = { before: [], after: [] };
        let orders = [], events = [], current = null;

        function todayISO() { const d = new Date(); return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`; }

        db.ref('appState').on('value', snap => {
            const st = snap.val() || {};
            orders = (Array.isArray(st.orders) ? st.orders : Object.values(st.orders || {})).filter(Boolean);
            events = (Array.isArray(st.scheduleEvents) ? st.scheduleEvents : Object.values(st.scheduleEvents || {})).filter(Boolean);
            renderOrderSelect();
        }, err => {
            console.error(err);
            document.getElementById('obj-order').innerHTML = '<option value="">Нет связи с CRM — заполните адрес вручную</option>';
        });

        function renderOrderSelect() {
            const sel = document.getElementById('obj-order');
            const cur = sel.value || (current && current.id) || '';
            const today = new Set(events.filter(e => e.date === todayISO()).map(e => e.orderId));
            const active = orders.filter(o => o.status !== 'Завершен');
            const t = active.filter(o => today.has(o.id)), rest = active.filter(o => !today.has(o.id));
            const opt = o => `<option value="${TT.esc(o.id)}">#${TT.esc(o.id)} · ${TT.esc(o.customerName)} · ${TT.esc(o.customerAddress)}</option>`;
            sel.innerHTML = '<option value="">— Без заказа (ввести вручную) —</option>' +
                (t.length ? `<optgroup label="Сегодня по графику">${t.map(opt).join('')}</optgroup>` : '') +
                (rest.length ? `<optgroup label="Другие активные">${rest.map(opt).join('')}</optgroup>` : '');
            if (cur && orders.some(o => o.id === cur)) sel.value = cur;
        }

        function pickOrder() {
            const id = document.getElementById('obj-order').value;
            current = orders.find(o => o.id === id) || null;
            const info = document.getElementById('order-info');
            if (!current) { info.classList.add('hidden'); return; }
            const ev = events.find(e => e.orderId === current.id && e.date === todayISO());
            info.classList.remove('hidden');
            info.innerHTML = `<b>${TT.esc(current.customerName)}</b> · ${TT.esc(current.customerPhone)}<br>🧹 ${TT.esc(current.serviceType)}` +
                (current.extras && current.extras.length ? `<br>➕ ${TT.esc(current.extras.join(', '))}` : '') +
                (current.kind === 'sub' ? `<br>🔁 Визит ${(current.visitsDone || 0) + 1} из ${current.visitsTotal || '?'}` : '') +
                (ev ? `<br>🕘 ${ev.startTime}–${ev.endTime}${ev.cleanerName ? ' · клинер ' + TT.esc(ev.cleanerName) : ''}` : '') +
                (current.note ? `<br>📝 ${TT.esc(current.note)}` : '');
            document.getElementById('obj-address').value = current.customerAddress || '';
            const obj = current.calc && current.calc.obj;
            if (obj) document.getElementById('obj-type').value = obj;
            document.getElementById('cleaning-type').value = TT.checklistKeyForOrder(current);
            renderChecklist();
        }

        function renderChecklist() {
            const type = document.getElementById('cleaning-type').value;
            const container = document.getElementById('checklist-container');
            container.innerHTML = TT.CHECKLISTS[type].map((item, idx) => `
                <label class="flex items-start gap-2.5 p-2 bg-white rounded-lg border border-slate-200 cursor-pointer hover:border-brand-500 transition">
                    <input type="checkbox" data-i="${idx}" class="checklist-item w-4 h-4 mt-0.5 accent-brand-600 rounded cursor-pointer" onchange="updateChecklistProgress()">
                    <span class="text-slate-700 font-medium">${idx + 1}. ${TT.esc(item)}</span>
                </label>`).join('');
            updateChecklistProgress();
        }

        function updateChecklistProgress() {
            const total = document.querySelectorAll('.checklist-item').length;
            const checked = document.querySelectorAll('.checklist-item:checked').length;
            document.getElementById('checklist-counter').innerText = `${checked} / ${total}`;
            document.getElementById('checklist-progress').style.width = `${total ? checked / total * 100 : 0}%`;
        }

        function setBadge(text, cls) {
            const b = document.getElementById('status-badge');
            b.innerText = text;
            b.className = 'px-2.5 py-1 rounded-full text-xs font-bold ' + cls;
        }

        function arriveOnSite() {
            const address = document.getElementById('obj-address').value.trim();
            if (!address) { alert('Выберите заказ или введите адрес объекта'); return; }
            if (!document.getElementById('sup-name').value.trim()) { alert('Укажите ваше имя'); return; }
            try { localStorage.setItem('tt_sup_name', document.getElementById('sup-name').value.trim()); } catch (e) {}
            setBadge('На объекте', 'bg-emerald-100 text-emerald-800');
            document.getElementById('step-2').classList.remove('step-inactive');
            if (current) {
                db.ref('appState/orders').transaction(list => {
                    if (!list) return list;
                    const arr = Array.isArray(list) ? list : Object.values(list);
                    const o = arr.find(x => x && x.id === current.id);
                    if (o && o.status !== 'Завершен') { o.status = 'В процессе'; o.arrivedAt = new Date().toISOString(); }
                    return list;
                }).catch(console.error);
            }
            window.open(WHATSAPP_SUPPORT_GROUP, '_blank');
        }

        async function handleFileSelect(input, stage) {
            const files = Array.from(input.files || []);
            input.value = '';
            for (const f of files.slice(0, Math.max(0, 8 - photos[stage].length))) {
                try { photos[stage].push(await TT.compressImage(f)); } catch (e) { console.error(e); }
            }
            renderPhotos(stage);
        }

        function renderPhotos(stage) {
            const preview = document.getElementById('preview-' + stage);
            preview.innerHTML = photos[stage].map((src, i) =>
                `<div class="relative"><img src="${src}" class="w-full h-20 object-cover rounded-lg border border-slate-200">
                 <button type="button" onclick="photos['${stage}'].splice(${i},1); renderPhotos('${stage}')" class="absolute top-1 right-1 w-6 h-6 rounded-full bg-black/60 text-white text-xs">✕</button></div>`).join('');
            const step = document.getElementById(stage === 'before' ? 'step-2' : 'step-4');
            step.querySelector('[data-cnt]').innerText = `${photos[stage].length} / 8 фото`;
        }

        function uploadFolder(stage) {
            if (!photos[stage].length) { alert('Сначала сделайте фотографии!'); return; }
            document.getElementById(stage === 'before' ? 'step-3' : 'step-5').classList.remove('step-inactive');
            document.getElementById(stage === 'before' ? 'step-3' : 'step-5').scrollIntoView({ behavior: 'smooth', block: 'start' });
        }

        function completeChecklist() {
            const checked = document.querySelectorAll('.checklist-item:checked').length;
            const total = document.querySelectorAll('.checklist-item').length;
            if (checked < total && !confirm(`Отмечено ${checked} из ${total} пунктов. Продолжить?`)) return;
            document.getElementById('step-4').classList.remove('step-inactive');
            document.getElementById('step-4').scrollIntoView({ behavior: 'smooth', block: 'start' });
        }

        async function acceptByClient() {
            const btn = document.getElementById('btn-accept');
            btn.disabled = true; btn.innerHTML = '⏳ Сохраняем отчёт…';
            const type = document.getElementById('cleaning-type').value;
            const boxes = Array.from(document.querySelectorAll('.checklist-item'));
            const report = {
                orderId: current ? current.id : 'NO-ORDER',
                supervisor: document.getElementById('sup-name').value.trim(),
                checklistType: type,
                done: boxes.filter(b => b.checked).length, total: boxes.length,
                missed: boxes.filter(b => !b.checked).map(b => TT.CHECKLISTS[type][+b.dataset.i]),
                remarks: document.getElementById('sup-remarks').value.trim(),
                photosBefore: photos.before.slice(), photosAfter: photos.after.slice(),
                customerName: current ? current.customerName : '',
                address: document.getElementById('obj-address').value.trim(),
                service: current ? current.serviceType : TT.CHECKLIST_NAMES[type],
                objType: document.getElementById('obj-type').value
            };
            try {
                const res = await TT.saveReport(db, report.orderId, report);
                const ord = res.order || current;
                btn.className = "w-full bg-emerald-600 text-white font-extrabold py-3.5 rounded-xl shadow-md text-xs flex items-center justify-center gap-2";
                btn.innerHTML = "✅ Отчёт сохранён, объект принят";
                const box = document.getElementById('report-result');
                box.classList.remove('hidden');
                box.innerHTML = `<div><b>Отчёт в CRM.</b>${ord && ord.kind === 'sub' ? ` Визит ${ord.visitsDone} из ${ord.visitsTotal}.` : ''}</div>` +
                    (ord && ord.customerPhone ? `<a target="_blank" href="${TT.waLink(ord.customerPhone, TT.clientReportMessage(ord, res.url, report))}" class="block text-center bg-[#25d366] text-white font-bold py-2.5 rounded-lg">📲 Отправить фотоотчёт клиенту</a>` : '') +
                    `<a target="_blank" href="https://wa.me/?text=${encodeURIComponent(`🎒 Отчёт Tap Taza\nЗаказ: #${report.orderId}\nАдрес: ${report.address}\nЧек-лист: ${report.done}/${report.total}\nФото: до ${report.photosBefore.length}, после ${report.photosAfter.length}\n${res.url}`)}" class="block text-center border border-slate-300 bg-white font-bold py-2.5 rounded-lg">💬 В группу WhatsApp</a>`;
                const exit = document.getElementById('btn-exit');
                exit.disabled = false; exit.classList.remove('opacity-50', 'cursor-not-allowed');
                setBadge('Сдано', 'bg-blue-100 text-blue-800');
            } catch (e) {
                console.error(e);
                btn.disabled = false; btn.innerHTML = '🤝 Объект принят — сохранить отчёт';
                alert('Не удалось сохранить отчёт. Проверьте интернет и нажмите ещё раз — фото не потеряются.');
            }
        }

        function leaveObject() {
            alert(`Смена на объекте "${document.getElementById('obj-address').value}" завершена!\nСпасибо за отличную работу.`);
            location.reload();
        }

        try { document.getElementById('sup-name').value = localStorage.getItem('tt_sup_name') || ''; } catch (e) {}
        renderChecklist();
    </script>
</body>
</html>
